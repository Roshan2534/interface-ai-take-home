# Copy to .env and fill one key. Do not put secrets in this file.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Optional. If several keys are set, pick openai | anthropic | gemini
# LLM_PROVIDER=openai

# Optional override. Defaults: gpt-6-astra, claude-sonnet-5, gemini-3.8-flash
# LLM_MODEL=

HCU_OPERATOR_ID=TELLER01
HCU_PASSWORD=train

# HITL. CLI --handoff / --handoff-max override these.
CUA_HANDOFF=wait
CUA_OPERATOR_PORT=7879
CUA_HANDOFF_MAX_ATTEMPTS=2

# Route allowlist (prefixes). The mock also has /wire and /gl-override; those are denied.
CUA_ALLOWED_PATH_PREFIXES=/health,/login,/console,/frame,/inquiry,/open,/training,/logout,/timeout,/print
CUA_DENIED_PATH_PREFIXES=/wire,/gl-override

# Watchable replay (--headed or record-demo). Headless without --record stays fast.
# CUA_PACE_MS=2500
# CUA_HIGHLIGHT_MS=1100
