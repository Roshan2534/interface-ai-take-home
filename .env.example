# Copy to .env and fill one key. Do not put secrets in this file.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Optional. If several keys are set, pick openai | anthropic | gemini
# LLM_PROVIDER=openai

# Optional override. Defaults: gpt-4o, claude-sonnet-4-5, gemini-2.5-flash
# LLM_MODEL=

HCU_OPERATOR_ID=TELLER01
HCU_PASSWORD=train

# HITL: wait (press Enter in the terminal to hand control back) | simulate | off
# CUA_HANDOFF=wait
# CUA_OPERATOR_PORT=7879
# How many times to hand the live window to a human before aborting (default 2)
# CLI --handoff-max overrides this.
# CUA_HANDOFF_MAX_ATTEMPTS=2
